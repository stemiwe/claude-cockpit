#!/usr/bin/env -S python3 -I
"""Runs the regular jobs of all workspace projects (rules C4). Started every 5 min by the systemd user
timer claude-jobs.timer; symlinked to ~/.local/bin/claude-jobs by install.sh.

A job is any executable file `<workspace>/<project>/jobs/<name>` with a line `# every: <n>m|h|d` in its
first 20 lines (e.g. `# every: 5h`). It runs with the project folder as working directory and a
30 min timeout. A job is due `every` after its last successful run; after a failure it is retried
with a backoff: 15 min, then 1 h, then at its normal interval (never later than that). After 3 failures in a
row the dashboard shows an alert (`fails` in state.json). Output goes to
~/.local/state/claude-jobs/logs/<project>__<name>.log.

Several machines: with `job_host` (a hostname) in cockpit.json, jobs run only on that machine, except jobs
with a line `# machines: all` (per-machine work like pulling and pushing the workspace). The job host
writes a heartbeat to <workspace>/.cockpit/job-host.json (versioned, so it reaches the other machines);
when it is older than a day, any machine runs the jobs, so they don't stop while the job host is off.
Without `job_host`, every job runs on every machine. A job with `# takeover: no` (e.g. one that deploys)
runs only on the job host, never by takeover.

Needs: a line `# needs: <need>; <need>…` makes a job "unavailable here" on a machine that lacks one: it
doesn't run, counts no failure and raises no alert (list: `unavailable: <need>`). Needs:
  secret <service> [<attr> <value>]…   a keyring entry (secret-tool lookup service <service> …)
  ssh <host>                           ssh -o BatchMode=yes <host> true works
  venv                                 the project has a .venv/
  host <name>                          only on that machine
Jobs get the desktop's SSH agent (/run/user/<uid>/gcr/ssh) when SSH_AUTH_SOCK is unset.

  claude-jobs                 run all due jobs (what the timer does)
  claude-jobs list            show every job with interval, last run, result and next due time
  claude-jobs list --json     the same as JSON (for the dashboard's Jobs tab)
  claude-jobs run <project>/<name>   run one job now
"""
import fcntl, json, os, re, subprocess, sys, time
from pathlib import Path

def workspace():
    """Workspace root: $CLAUDE_WORKSPACE, else ~/.config/claude-cockpit/workspace (written by install.sh), else ~/claude."""
    p = os.environ.get("CLAUDE_WORKSPACE", "")
    if not p:
        try: p = (Path.home() / ".config/claude-cockpit/workspace").read_text().strip()
        except OSError: pass
    return Path(p or "~/claude").expanduser()

ROOT = workspace()
STATE = Path.home() / ".local/state/claude-jobs"
LOGS = STATE / "logs"
TIMEOUT = 30 * 60
RETRY = [15 * 60, 3600]   # backoff after the 1st and 2nd failure in a row; then `every`
ALERT = 3                # failures in a row that the dashboard shows
MAX_LOG = 256 * 1024     # keep logs small: trim to the last half when bigger
SKIP_DIRS = {".git", ".venv", "node_modules"}
UNITS = {"m": 60, "h": 3600, "d": 86400}
HOST = os.uname().nodename
HEARTBEAT = ROOT / ".cockpit/job-host.json"
NEEDS = {}              # job id -> ([need, …], takeover forbidden), filled by find_jobs
_probed = {}
GCR_SSH = f"/run/user/{os.getuid()}/gcr/ssh"
if not os.environ.get("SSH_AUTH_SOCK") and os.path.exists(GCR_SSH):
    os.environ["SSH_AUTH_SOCK"] = GCR_SSH   # the desktop's SSH agent, for jobs and the ssh probe
STALE = 86400           # job host silent this long -> the other machines take over

def find_jobs():
    for dirpath, dirnames, _ in os.walk(ROOT):
        rel = os.path.relpath(dirpath, ROOT)
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")
                             and os.path.normpath(os.path.join(rel, d)) not in HIDDEN)
        if Path(dirpath).name != "jobs":
            continue
        dirnames[:] = []
        for f in sorted(Path(dirpath).iterdir()):
            if not f.is_file() or not os.access(f, os.X_OK):
                continue
            try:
                head = f.read_text(errors="replace").splitlines()[:20]
            except OSError:
                continue
            m = next((re.search(r"#\s*every:\s*(\d+)\s*([mhd])\b", l) for l in head
                      if re.search(r"#\s*every:", l)), None)
            if m and not archived(f.parent.parent):
                project = str(f.parent.parent.relative_to(ROOT)) if f.parent.parent != ROOT else ROOT.name
                every_machine = any(re.search(r"#\s*machines:\s*all\b", l) for l in head)
                NEEDS[f"{project}/{f.name}"] = (
                    [n.split() for l in head for mm in [re.search(r"#\s*needs:\s*(.+)", l)] if mm
                     for n in mm.group(1).split(";") if n.split()],
                    any(re.search(r"#\s*takeover:\s*no\b", l) for l in head))
                yield f"{project}/{f.name}", f, int(m.group(1)) * UNITS[m.group(2)], every_machine

try:
    CONFIG = json.loads((ROOT / "cockpit.json").read_text())
except (OSError, ValueError):
    CONFIG = {}
HIDDEN = set(CONFIG.get("hidden", []))   # skipped folders
JOB_HOST = CONFIG.get("job_host", "")

def single_jobs_here():
    """Whether jobs without `# machines: all` run on this machine (see the docstring)."""
    if not JOB_HOST: return True
    if HOST == JOB_HOST:
        try: beat = json.loads(HEARTBEAT.read_text()).get("ts", 0)
        except (OSError, ValueError): beat = 0
        if time.time() - beat > 3600:   # refresh at most hourly, to keep the workspace's git history quiet
            HEARTBEAT.parent.mkdir(parents=True, exist_ok=True)
            HEARTBEAT.write_text(json.dumps({"host": HOST, "ts": int(time.time())}) + "\n")
        return True
    try: beat = json.loads(HEARTBEAT.read_text())
    except (OSError, ValueError): return True
    return beat.get("host") != JOB_HOST or time.time() - beat.get("ts", 0) > STALE

def probe(need, project_dir):
    """True if this machine meets one need (see the docstring); cached per run."""
    key = (tuple(need), project_dir if need[0] == "venv" else None)
    if key in _probed: return _probed[key]
    kind, args = need[0], need[1:]
    try:
        if kind == "secret" and args:
            ok = bool(subprocess.run(["secret-tool", "lookup", "service", *args], capture_output=True,
                                     text=True, timeout=20).stdout.strip())
        elif kind == "ssh" and len(args) == 1:
            ok = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", args[0], "true"],
                                stdin=subprocess.DEVNULL, capture_output=True, timeout=20).returncode == 0
        elif kind == "venv":
            ok = (project_dir / ".venv").is_dir()
        elif kind == "host" and len(args) == 1:
            ok = HOST == args[0]
        else:
            ok = True   # unknown need: don't block the job
    except (OSError, subprocess.TimeoutExpired):
        ok = False
    _probed[key] = ok
    return ok

def unavailable(job_id, path):
    """The first need this machine lacks, as text, else None."""
    for need in NEEDS.get(job_id, ([], False))[0]:
        if not probe(need, path.parent.parent): return " ".join(need)
    return None

def runs_here(job_id, every_machine, here):
    """Whether the job runs on this machine (job host, takeover, `# takeover: no`)."""
    if every_machine: return True
    if NEEDS.get(job_id, ([], False))[1] and JOB_HOST and HOST != JOB_HOST: return False
    return here

def archived(project_dir):
    """True if the project's CLAUDE.md has a "Status: archived …" line (rules C1): its jobs don't run."""
    try:
        return any(l.lower().startswith("status: archived")
                   for l in (project_dir / "CLAUDE.md").read_text(errors="replace").splitlines()[:8])
    except OSError:
        return False

def load_state():
    try:
        return json.loads((STATE / "state.json").read_text())
    except (OSError, ValueError):
        return {}

def save_state(state):
    tmp = STATE / "state.json.tmp"
    tmp.write_text(json.dumps(state, indent=1))
    tmp.replace(STATE / "state.json")

def due_at(job_id, every, state):
    s = state.get(job_id, {})
    if not s: return 0
    if s.get("ok"): return s["last"] + every
    fails = s.get("fails", 1)
    return s["last"] + min(RETRY[fails - 1] if fails <= len(RETRY) else every, every)

def run(job_id, path, state):
    log = LOGS / (job_id.replace("/", "__") + ".log")
    start = time.time()
    with log.open("a") as fh:
        fh.write(f"\n=== {time.strftime('%F %T')} start\n"); fh.flush()
        try:
            rc = subprocess.run([str(path)], cwd=path.parent.parent, stdout=fh, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, timeout=TIMEOUT).returncode
        except subprocess.TimeoutExpired:
            rc = "timeout"
        except OSError as e:
            fh.write(f"{e}\n"); rc = "error"
        fh.write(f"=== {time.strftime('%F %T')} exit {rc} ({time.time() - start:.0f}s)\n")
    if log.stat().st_size > MAX_LOG:
        data = log.read_bytes()[-MAX_LOG // 2:]
        log.write_bytes(data[data.find(b"\n") + 1:])
    fails = 0 if rc == 0 else state.get(job_id, {}).get("fails", 0) + 1
    state[job_id] = {"last": start, "ok": rc == 0, "rc": rc, "fails": fails}
    save_state(state)
    return rc

def fmt(ts):
    return time.strftime("%a %d.%m %H:%M", time.localtime(ts)) if ts else "—"

def main():
    LOGS.mkdir(parents=True, exist_ok=True)
    args = sys.argv[1:]
    state = load_state()
    jobs = list(find_jobs())
    if args[:1] == ["list"]:
        here = single_jobs_here()
        miss = {j: unavailable(j, p) for j, p, _, em in jobs if runs_here(j, em, here)}
        if args[1:2] == ["--json"]:
            print(json.dumps([{"id": job_id, "project": job_id.rsplit("/", 1)[0], "every": every,
                               "last": state.get(job_id, {}).get("last"), "ok": state.get(job_id, {}).get("ok"),
                               "rc": state.get(job_id, {}).get("rc"), "fails": state.get(job_id, {}).get("fails", 0),
                               "next": due_at(job_id, every, state) if runs_here(job_id, every_machine, here)
                                       and not miss.get(job_id) else None,
                               "host": None if runs_here(job_id, every_machine, here) else JOB_HOST,
                               "unavailable": miss.get(job_id)}
                              for job_id, path, every, every_machine in jobs]))
            return
        for job_id, path, every, every_machine in jobs:
            s = state.get(job_id, {})
            res = "never run" if not s else ("ok" if s.get("ok") else f"FAILED ({s.get('rc')}) ×{s.get('fails', 1)}")
            nxt = (f"unavailable: {miss[job_id]}" if miss.get(job_id) else
                   (fmt(due_at(job_id, every, state)) if s else "now")) if runs_here(job_id, every_machine, here) \
                else f"on {JOB_HOST}"
            print(f"{job_id:40} every {every // 3600}h{every % 3600 // 60:02d}m  last {fmt(s.get('last'))}  "
                  f"{res:16}  next {nxt}")
        return
    lock = open(STATE / "lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("claude-jobs: already running")
    if args[:1] == ["run"] and len(args) == 2:
        match = [(i, p) for i, p, _, _ in jobs if i == args[1]]
        if not match: sys.exit(f"no such job: {args[1]} (see `claude-jobs list`)")
        rc = run(*match[0], state)
        print(f"{args[1]}: exit {rc}, log in {LOGS}")
        sys.exit(0 if rc == 0 else 1)
    # Heartbeat for the dashboards on other machines: this machine's running sessions (lib/presence)
    try: subprocess.run([Path(__file__).resolve().parent.parent / "lib/presence", "push", "--now"], timeout=60,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.TimeoutExpired: pass
    now, here = time.time(), single_jobs_here()
    for job_id, path, every, every_machine in jobs:
        if runs_here(job_id, every_machine, here) and due_at(job_id, every, state) <= now \
                and not unavailable(job_id, path):
            run(job_id, path, state)

main()
